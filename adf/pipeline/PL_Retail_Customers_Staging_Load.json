				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_merge_customers]"
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Retail_Metadata",
					"type": "LinkedServiceReference"
				}
			}
		],
		"annotations": []
	}
}