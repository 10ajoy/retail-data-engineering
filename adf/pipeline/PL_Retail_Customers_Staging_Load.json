				"name": "Copy_Customers_To_Staging",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SQL_Clear_Customer_Staging",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
