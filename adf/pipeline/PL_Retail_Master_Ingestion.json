{
	"name": "PL_Retail_Master_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Ingestion_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    ingestion_id,\n    source_container,\n    source_folder,\n    source_file_name,\n    sink_container,\n    sink_folder,\n    sink_file_name,\n    file_format\nFROM dbo.ingestion_config\nWHERE is_active = 1;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_Ingestion_Config_SQL",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Ingestion_Config",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Ingestion_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Ingestion_Config').output.value",
						"type": "Expression"
					},
					"isSequential": true
				}
			}
		],
		"annotations": []
	}
}