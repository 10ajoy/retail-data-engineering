{
	"name": "PL_Retail_Orders_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Copy_Orders_To_Landing",
				"description": "Copy retail orders CSV from source to landing",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SP_Audit_Start",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Retail_Orders_Source",
						"type": "DatasetReference",
						"parameters": {
							"folderPath": {
								"value": "@pipeline().parameters.pSourceFolder",
								"type": "Expression"
							},
							"fileName": {
								"value": "@pipeline().parameters.pSourceFile",
								"type": "Expression"
							},
							"containerName": {
								"value": "@pipeline().parameters.pSourceContainer",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Retail_Orders_Landing",
						"type": "DatasetReference",
						"parameters": {
							"folderPath": {
								"value": "@pipeline().parameters.pSinkFolder",
								"type": "Expression"
							},
							"fileName": {
								"value": "@pipeline().parameters.pSinkFile",
								"type": "Expression"
							},
							"containerName": {
								"value": "@pipeline().parameters.pSinkContainer",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SP_Audit_Start",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_ingestion_audit_start]",
					"storedProcedureParameters": {
						"ingestion_id": {
							"value": {
								"value": "@pipeline().parameters.pIngestionId",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"pipeline_name": {
							"value": {
								"value": "PL_Retail_Orders_Ingestion",
								"type": "Expression"
							},
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"parent_pipeline_run_id": {
							"value": {
								"value": "@pipeline().parameters.pParentPipelineRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"source_file_name": {
							"value": {
								"value": "@pipeline().parameters.pSourceFile",
								"type": "Expression"
							},
							"type": "String"
						},
						"sink_file_name": {
							"value": {
								"value": "@pipeline().parameters.pSinkFile",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Retail_Metadata",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Audit_Success",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_Orders_To_Landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_ingestion_audit_success]",
					"storedProcedureParameters": {
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"data_read_bytes": {
							"value": {
								"value": "@activity('Copy_Orders_To_Landing').output.dataRead",
								"type": "Expression"
							},
							"type": "Int16"
						},
						"data_written_bytes": {
							"value": {
								"value": "@activity('Copy_Orders_To_Landing').output.dataWritten",
								"type": "Expression"
							},
							"type": "Int16"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Retail_Metadata",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Audit_Failure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_Orders_To_Landing",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_ingestion_audit_failure]",
					"storedProcedureParameters": {
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"error_message": {
							"value": {
								"value": "@string(activity('Copy_Orders_To_Landing').error.message)",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Retail_Metadata",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"pSourceFolder": {
				"type": "string",
				"defaultValue": "source/orders"
			},
			"pSourceFile": {
				"type": "string",
				"defaultValue": "orders.csv"
			},
			"pSinkFolder": {
				"type": "string",
				"defaultValue": "landing/orders"
			},
			"pSinkFile": {
				"type": "string",
				"defaultValue": "orders_copy.csv"
			},
			"pSourceContainer": {
				"type": "string",
				"defaultValue": "datalake"
			},
			"pSinkContainer": {
				"type": "string",
				"defaultValue": "datalake"
			},
			"pIngestionId": {
				"type": "int"
			},
			"pParentPipelineRunId": {
				"type": "string"
			}
		},
		"annotations": []
	}
}