{
	"name": "PL_Retail_Customers_Incremental_Copy",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Customers_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    ingestion_id,\n    source_container,\n    source_folder,\n    source_file_name,\n    sink_container,\n    sink_folder,\n    sink_file_name,\n    load_type,\n    watermark_column,\n    last_watermark_value\nFROM dbo.ingestion_config\nWHERE load_type = 'INCREMENTAL'\n  AND source_folder = 'source/customers/incremental'\n  AND source_file_name = 'customers_delta.csv'\n  AND is_active = 1;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_Ingestion_Config_SQL",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "PL_Retail_Customers_Incremental_Copy",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup_Customers_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Customers_Delta_Source",
						"type": "DatasetReference",
						"parameters": {
							"containerName": {
								"value": "@activity('Lookup_Customers_Config').output.firstRow.source_container",
								"type": "Expression"
							},
							"folderPath": {
								"value": "@activity('Lookup_Customers_Config').output.firstRow.source_folder",
								"type": "Expression"
							},
							"fileName": {
								"value": "@activity('Lookup_Customers_Config').output.firstRow.source_file_name",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Customers_Incremental_Sink",
						"type": "DatasetReference",
						"parameters": {
							"containerName": {
								"value": "@activity('Lookup_Customers_Config').output.firstRow.sink_container",
								"type": "Expression"
							},
							"folderPath": {
								"value": "@activity('Lookup_Customers_Config').output.firstRow.sink_folder",
								"type": "Expression"
							},
							"fileName": {
								"value": "@activity('Lookup_Customers_Config').output.firstRow.sink_file_name",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SP_Update_Customers_Watermark",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "PL_Retail_Customers_Incremental_Copy",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_update_ingestion_watermark]",
					"storedProcedureParameters": {
						"ingestion_id": {
							"value": {
								"value": "@activity('Lookup_Customers_Config').output.firstRow.ingestion_id",
								"type": "Expression"
							},
							"type": "Int16"
						},
						"new_watermark_value": {
							"value": "2026-11-20T10:00:00",
							"type": "Datetime"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Retail_Metadata",
					"type": "LinkedServiceReference"
				}
			}
		],
		"annotations": []
	}
}