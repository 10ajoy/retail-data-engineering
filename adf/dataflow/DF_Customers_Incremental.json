{
	"name": "DF_Customers_Incremental",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Customers_Delta_Source",
						"type": "DatasetReference"
					},
					"name": "SourceCustomersDelta"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "FilterNewAndUpdatedCustomers"
				}
			],
			"scriptLines": [
				"parameters{",
				"     watermark_value as string ('2026-11-20 09:00:00')",
				"}",
				"source(output(",
				"          customer_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          city as string,",
				"          state as string,",
				"          registration_date as string,",
				"          status as string,",
				"          created_at as string,",
				"          updated_at as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SourceCustomersDelta",
				"SourceCustomersDelta filter(ERROR_FUNCTION('toTimestamp(updated_at, __SINGLE_QUOTE__yyyy-MM-dd__SINGLE_QUOTE____SINGLE_QUOTE__T__SINGLE_QUOTE____SINGLE_QUOTE__HH:mm:ss__SINGLE_QUOTE__)__NEW_LINE_N__    > toTimestamp($watermark_value, __SINGLE_QUOTE__yyyy-MM-dd HH:mm:ss__SINGLE_QUOTE__)')) ~> FilterNewAndUpdatedCustomers"
			]
		}
	}
}