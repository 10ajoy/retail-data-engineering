{
	"name": "DF_Customers_Incremental",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Customers_Delta_Source",
						"type": "DatasetReference"
					},
					"name": "SourceCustomersDelta"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Customers_Incremental_Sink",
						"type": "DatasetReference"
					},
					"name": "SinkCustomersIncremental"
				}
			],
			"transformations": [
				{
					"name": "FilterNewAndUpdatedCustomers"
				}
			],
			"scriptLines": [
				"parameters{",
				"     watermark_value as string ('2026-11-20 09:00:00')",
				"}",
				"source(output(",
				"          customer_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          city as string,",
				"          state as string,",
				"          registration_date as string,",
				"          status as string,",
				"          created_at as string,",
				"          updated_at as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SourceCustomersDelta",
				"SourceCustomersDelta filter(toTimestamp(updated_at) > toTimestamp($watermark_value)) ~> FilterNewAndUpdatedCustomers",
				"FilterNewAndUpdatedCustomers sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SinkCustomersIncremental"
			]
		}
	}
}